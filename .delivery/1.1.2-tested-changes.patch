diff --git a/src/mobile/BulkManage.jsx b/src/mobile/BulkManage.jsx
new file mode 100644
index 0000000..e4c1386
--- /dev/null
+++ b/src/mobile/BulkManage.jsx
@@ -0,0 +1,24 @@
+import React,{useMemo,useState} from 'react';
+import {activeGroups} from '../vault/workspace.js';
+import {batchGroupEntries,batchTrashEntries} from '../vault/workspace-actions.js';
+import {referenceBirthLabel} from './list-utils.js';
+import './bulk-manage.css';
+export default function BulkManage({vault,change,busy,navigate}){
+ const [search,setSearch]=useState(''),[selected,setSelected]=useState([]),[groupId,setGroupId]=useState(''),[intent,setIntent]=useState(null);
+ const entries=useMemo(()=>vault.entries.filter(e=>!e.deletedAt),[vault.entries]);
+ const groups=activeGroups(vault);
+ const matches=entries.filter(e=>e.name.toLocaleLowerCase('ko').includes(search.trim().toLocaleLowerCase('ko'))||String(e.birth?.date_raw||'').includes(search.trim()));
+ const chosen=entries.filter(e=>selected.includes(e.id));
+ const toggle=id=>setSelected(list=>list.includes(id)?list.filter(x=>x!==id):[...list,id]);
+ const apply=async()=>{
+   const ids=[...selected],mode=intent;
+   const outcome=await change(s=>mode==='trash'?batchTrashEntries(s,ids):batchGroupEntries(s,{ids,groupId,mode}),mode==='trash'?'선택한 명식을 휴지통으로 옮겼습니다.':'그룹 배정을 변경했습니다.');
+   if(outcome){setSelected([]);setIntent(null);}
+ };
+ return <section className="bm-page"><header><h1>명식 일괄 관리</h1><p>명식 원본·메모를 유지하면서 그룹을 여러 건 관리합니다. 삭제는 휴지통으로 이동합니다.</p></header>
+ <div className="bm-panel"><label>명식 검색<input type="search" aria-label="일괄 명식 검색" placeholder="이름 또는 저장 생년월일" value={search} onChange={e=>setSearch(e.target.value)}/></label><div className="bm-action-row"><strong>{selected.length}명 선택</strong><button type="button" onClick={()=>setSelected(list=>[...new Set([...list,...matches.map(e=>e.id)])])}>검색 결과 전체 선택</button><button type="button" onClick={()=>setSelected([])}>선택 해제</button></div>
+ <ul className="bm-list">{matches.map(e=><li key={e.id}><label><input type="checkbox" checked={selected.includes(e.id)} onChange={()=>toggle(e.id)}/><span><b>{e.name}</b><small>{referenceBirthLabel(e)}</small></span></label></li>)}</ul>{matches.length===0&&<p>검색한 명식이 없습니다.</p>}</div>
+ <div className="bm-panel"><label>대상 그룹<select aria-label="일괄 대상 그룹" value={groupId} onChange={e=>setGroupId(e.target.value)}><option value="">그룹 선택</option>{groups.map(g=><option value={g.id} key={g.id}>{g.name}</option>)}</select></label><div className="bm-action-row"><button type="button" disabled={busy||selected.length===0||!groupId} onClick={()=>setIntent('add')}>그룹에 추가</button><button type="button" disabled={busy||selected.length===0||!groupId} onClick={()=>setIntent('remove')}>그룹에서 제외</button><button className="bm-danger" type="button" disabled={busy||selected.length===0} onClick={()=>setIntent('trash')}>휴지통 이동</button></div>{!groups.length&&<p>그룹이 없습니다. <button type="button" onClick={()=>navigate({name:'groups'})}>그룹 관리로 이동</button></p>}</div>
+ {intent&&<section className="bm-confirm" role="alertdialog" aria-label="일괄 변경 확인" aria-modal="true"><h2>선택한 {chosen.length}명의 명식을 {intent==='trash'?'휴지통으로 옮길까요?':intent==='add'?'그룹에 추가할까요?':'그룹에서 제외할까요?'}</h2><p>일괄 작업은 현재 기기에 저장됩니다. 휴지통에 들어간 명식은 설정에서 복원할 수 있습니다.</p><div className="bm-action-row"><button type="button" onClick={()=>setIntent(null)} disabled={busy}>취소</button><button type="button" onClick={apply} disabled={busy}>{busy?'처리 중':'확인'}</button></div></section>}
+ </section>;
+}
diff --git a/src/mobile/ChartExport.jsx b/src/mobile/ChartExport.jsx
new file mode 100644
index 0000000..521b5cb
--- /dev/null
+++ b/src/mobile/ChartExport.jsx
@@ -0,0 +1,36 @@
+import React,{useState} from 'react';
+import {HS,EB,STEM_KO,BRANCH_KO} from './engine.js';
+import {exportPngFile} from '../vault/persistence.js';
+const group=stem=>({甲:'#27a983',乙:'#27a983',丙:'#ed586b',丁:'#ed586b',戊:'#f3c938',己:'#f3c938',庚:'#d3e3e7',辛:'#d3e3e7',壬:'#373f4b',癸:'#373f4b'})[stem]||'#edf1f6';
+const branch=stem=>({子:'#373f4b',丑:'#f3c938',寅:'#27a983',卯:'#27a983',辰:'#f3c938',巳:'#ed586b',午:'#ed586b',未:'#f3c938',申:'#d3e3e7',酉:'#d3e3e7',戌:'#f3c938',亥:'#373f4b'})[stem]||'#edf1f6';
+function drawWrappedText(ctx,content,x,y,width,lineHeight){let buffer='';for(const char of content){if(ctx.measureText(buffer+char).width>width){ctx.fillText(buffer,x,y);y+=lineHeight;buffer='';}buffer+=char;}if(buffer)ctx.fillText(buffer,x,y);return y;}
+/** Renders a new offscreen image; never captures a private page or sends data to a server. */
+export function renderChartPng({name,birth,columns,selectedYear}){
+ const canvas=document.createElement('canvas');canvas.width=1200;canvas.height=930;
+ const g=canvas.getContext('2d');if(!g)throw new Error('이 기기는 이미지 생성을 지원하지 않습니다.');
+ g.fillStyle='#fff';g.fillRect(0,0,1200,930);
+ g.fillStyle='#42526d';g.font='bold 44px sans-serif';g.fillText('사주 명식',65,90);
+ g.font='31px sans-serif';drawWrappedText(g,`${name} · ${birth||'생년월일 미확인'}`,65,145,1050,38);
+ const label=['세운','대운','시주','일주','월주','연주'];
+ for(let i=0;i<6;i++){
+  const x=45+i*185,c=columns?.[i],p=c?.kind==='calculated'?c.pillar:null;
+  g.fillStyle=i===3?'#fef6d9':'#f2f6fb';g.fillRect(x,218,178,502);
+  g.textAlign='center';g.fillStyle='#58677b';g.font='28px sans-serif';g.fillText(label[i],x+89,258);
+  for(const [row,sym,background] of [[0,p?.stem,group],[1,p?.branch,branch]]){
+   const y=288+row*185,fill=background(sym);g.fillStyle=fill;
+   g.beginPath();g.roundRect(x+12,y,154,155,22);g.fill();
+   g.fillStyle=['#373f4b','#ed586b','#27a983'].includes(fill)?'#fff':'#384653';g.font='bold 82px serif';g.fillText(sym||'—',x+89,y+95);
+   const map=row===0?HS:EB,ko=row===0?STEM_KO:BRANCH_KO;
+   g.font='27px sans-serif';g.fillText(sym?ko[map.indexOf(sym)]||'':'미확인',x+89,y+132);
+  }
+  g.fillStyle='#748095';g.font='22px sans-serif';g.fillText(c?.kind==='reference'?'원문 확인 전':p?'계산된 명식':'미상',x+89,693);
+ }
+ g.textAlign='left';g.fillStyle='#47576f';g.font='28px sans-serif';g.fillText(`선택 연도 ${selectedYear}년`,65,795);
+ g.fillStyle='#8793a6';g.font='24px sans-serif';g.fillText('이 파일은 개인 정보를 포함할 수 있습니다. 공유 전 내용을 확인하세요.',65,858);
+ return canvas.toDataURL('image/png');
+}
+export default function ChartExport({entry,columns,year,busy}){
+ const [working,setWorking]=useState(false),[message,setMessage]=useState('');
+ const save=async()=>{setWorking(true);setMessage('');try{const image=renderChartPng({name:entry.name,birth:entry.birth?.date_raw||'',columns,selectedYear:year});await exportPngFile(image,`명식_${new Date().toISOString().slice(0,10)}.png`);setMessage('명식 이미지를 저장했습니다.');}catch(e){setMessage(e.message||'이미지 내보내기가 실패했습니다.');}finally{setWorking(false);}};
+ return <div className="chart-export"><button type="button" className="rr-secondary-action" disabled={busy||working} onClick={save}>명식 이미지 PNG로 저장</button><small>이름·생년월일이 포함될 수 있습니다. 저장 전 개인정보를 확인하세요.</small>{message&&<p role="status">{message}</p>}</div>;
+}
diff --git a/src/mobile/FortuneTimeline.jsx b/src/mobile/FortuneTimeline.jsx
new file mode 100644
index 0000000..738eee0
--- /dev/null
+++ b/src/mobile/FortuneTimeline.jsx
@@ -0,0 +1,24 @@
+import React,{useMemo,useState} from 'react';
+import {FORTUNE_AREAS,fortuneMonthTimeline,areaMonths} from './fortune-model.js';
+import {STEM_KO,BRANCH_KO,HS,EB} from './engine.js';
+import './fortune-timeline.css';
+const ko=p=>p?STEM_KO[HS.indexOf(p.stem)]+BRANCH_KO[EB.indexOf(p.branch)]:null;
+export default function FortuneTimeline({result,year,policy,onSelect,busy}){
+ const [area,setArea]=useState('all');
+ const timeline=useMemo(()=>fortuneMonthTimeline(result,year,policy),[result,year,policy]);
+ const focus=FORTUNE_AREAS.find(a=>a.id===area);
+ const matching=area==='all'?timeline.months:areaMonths(timeline,area);
+ return <section className="ft-root" aria-label="분야별 월운 흐름"><header className="ft-header"><h2>분야별 월운 흐름</h2><span>{year}년</span></header>
+  <p className="ft-note">십성에 따른 월별 관심 분야를 보여줍니다. 점수·예언 대신 계산된 간지와 근거만 표시합니다.</p>
+  {timeline.status!=='ready'?<p role="status">{timeline.reason}</p>:<>
+   <div role="group" aria-label="관심 분야 필터" className="ft-filters"><button type="button" aria-pressed={area==='all'} onClick={()=>setArea('all')}>전체</button>{FORTUNE_AREAS.map(a=><button type="button" key={a.id} aria-pressed={area===a.id} onClick={()=>setArea(a.id)}>{a.label}</button>)}</div>
+   {focus&&<p className="ft-explanation">{focus.explanation}</p>}
+   <div className="ft-months">{matching.map(m=><button type="button" key={m.month} disabled={busy||Boolean(m.error)} aria-label={`${m.month}월 ${m.error||m.god+' '+ko(m.pillar)} 선택`} onClick={()=>onSelect({date:m.date,hour:12,minute:0})}>
+     <span className="ft-month">{m.month}월</span><strong>{ko(m.pillar)||'—'}</strong><small>{m.god||'계산 불가'}</small><em>{FORTUNE_AREAS.find(a=>a.id===m.focusId)?.label||'미분류'}</em>
+     {(m.dayBranchRelations||[]).length>0&&<small>일지 {m.dayBranchRelations.join('·')}</small>}
+   </button>)}</div>
+   {!matching.length&&<p role="status" className="ft-explanation">선택한 분야의 천간 십성은 이 표본 월에 없습니다. 다른 분야 또는 전체를 선택하세요.</p>}
+   <p className="ft-foot">{timeline.explanation} 월을 누르면 해당 날짜 12:00로 일·시운을 변경합니다. 저장된 출생정보는 바뀌지 않습니다.</p>
+  </>}
+ </section>;
+}
